# ─── Terraform ────────────────────────────────────────────────────────────────
# Local .terraform directories (downloaded providers/modules — large, machine-specific)
**/.terraform/*

# State files — can contain secrets; NEVER commit (they live in S3 remotely)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variable files with real/secret values — commit only the *.example template
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform lock info & CLI config
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ─── AWS / secrets ────────────────────────────────────────────────────────────
# Never commit credentials
.aws/
*.pem
*accessKeys*.csv
credentials

# ─── Local data & Python (not committed — large / machine-specific) ────────────
foundations/data/
.venv*/
__pycache__/
*.pyc

# ─── dbt (generated build artifacts + connection secrets) ───────────────────────
dbt/target/
dbt/logs/
dbt/dbt_packages/
profiles.yml            # real connection config (commit only profiles.yml.example)
!profiles.yml.example

# ─── OS / editor noise ────────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
